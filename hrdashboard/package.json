{
  "name": "hrdashboard",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "axios": "^1.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.1",
    "react-scripts": "5.0.1",
    "web-vitals": "^5.2.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "spec:fetch": "node scripts/fetch-openapi-spec.js",
    "spec:types": "openapi-typescript src/api/openapi.json -o src/api/api-types.d.ts",
    "spec:update": "npm run spec:fetch && npm run spec:types"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
